{
  "Serilog": {
    "Using": [
      "Serilog",
      "Serilog.Sinks.File"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "%APPDATA%\\WelpenScoreboard\\Logs\\log.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 365,
          "fileSizeLimitBytes": 10485760
        }
      }
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    }
  }
}