<UserControl x:Class="WelpenScoreboard.WpfUI.Views.GroupSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WelpenScoreboard.WpfUI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <materialDesign:Card Grid.Column="0"
                                 Margin="5">
                <ListBox x:Name="LbGroup1"
                         
                         FontSize="18"
                         
                         Foreground="White"
                         VerticalAlignment="Stretch" />
            </materialDesign:Card>
            

            <ListBox x:Name="LbGroup2"
                     Grid.Column="1"
                     FontSize="18"
                     Margin="5"
                     Background="Black"
                     Foreground="White" />
            <ListBox x:Name="LbGroup3"
                     Grid.Column="2"
                     FontSize="18"
                     Margin="5"
                     Background="Black"
                     Foreground="White" />
            <ListBox x:Name="LbGroup4"
                     Grid.Column="3"
                     FontSize="18"
                     Margin="5"
                     Background="Black"
                     Foreground="White" />
            <ListBox x:Name="LbGroup5"
                     Grid.Column="4"
                     FontSize="18"
                     Margin="5"
                     Background="Black"
                     Foreground="White" />
            <ListBox x:Name="LbGroup6"
                     Grid.Column="5"
                     FontSize="18"
                     Margin="5"
                     Background="Black"
                     Foreground="White" />
        </Grid>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.Resources>
                <Style TargetType="TextBlock"
                       BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Margin"
                            Value="10,15,10,5" />
                </Style>
            </Grid.Resources>
            
            <TextBlock Text="Groep 1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="0"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />
            <TextBlock Text="Groep 2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="1"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />
            <TextBlock Text="Groep 3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="2"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />
            <TextBlock Text="Groep 4"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="3"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />
            <TextBlock Text="Groep 5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="4"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />
            <TextBlock Text="Groep 6"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Grid.Column="5"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       FontStyle="Italic" />

        </Grid>
        <materialDesign:Card Grid.Row="2"
                             HorizontalAlignment="Left"
                             Margin="5">
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        VerticalAlignment="Center">
                <TextBox x:Name="TbNewPerson"
                         FontSize="20"
                         InputScope="Default"
                         Margin="5"
                         MinWidth="150"
                         MaxLength="15"
                         materialDesign:HintAssist.Hint="Naam"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center" />
                <TextBox MaxHeight="60"
                         x:Name="TbGroup"
                         FontSize="20"
                         InputScope="Number"
                         MaxLength="1"
                         Margin="5"
                         MinWidth="40"
                         materialDesign:HintAssist.Hint="Groep"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                <Button x:Name="BtnNewPerson"
                        FontSize="20"
                        MinWidth="50"
                        Foreground="White"
                        Margin="5,0">
                    <materialDesign:PackIcon Kind="Add"
                                             Height="24"
                                             Width="24" />
                </Button>

            </StackPanel>
        </materialDesign:Card>

        <Button x:Name="BtnRemove"
                FontSize="20"
                Foreground="White"
                Margin="5"
                Grid.Row="2"
                HorizontalAlignment="Right"
                Style="{StaticResource MaterialDesignRaisedButton}"
                Height="35">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Verwijder geselecteerde"
                           Margin="7,0" />
            </StackPanel>

        </Button>

        <Border x:Name="PopupNameUnique"
                BorderThickness="3"
                BorderBrush="Gray"
                CornerRadius="5"
                Grid.Row="1"
                MaxWidth="300"
                MaxHeight="150"
                Visibility="Collapsed">
            <Grid Background="Black">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TxtNameExists"
                               Text="Naam bestaat al in een van de groepjes"
                               Foreground="White"
                               VerticalAlignment="Center"
                               FontSize="20"
                               TextWrapping="Wrap"
                               Margin="5" />
                    <Button x:Name="BtnBack"
                            Content="Ok"
                            Background="SlateGray"
                            HorizontalAlignment="Right"
                            MinWidth="100"
                            BorderBrush="Gray" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
