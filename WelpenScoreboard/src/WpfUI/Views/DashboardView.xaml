<UserControl x:Class="WelpenScoreboard.WpfUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:WelpenScoreboard.WpfUI.Views"
             xmlns:vm="clr-namespace:WelpenScoreboard.WpfUI.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Grid.RowSpan="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Rectangle Fill="#FF00AB08"
                       Grid.Column="0" />
            <Rectangle Fill="#FF00C301"
                       Grid.Column="1" />
            <Rectangle Fill="#FF26D701"
                       Grid.Column="2" />
            <Rectangle Fill="#FF26D701"
                       Grid.Column="3" />
            <Rectangle Fill="#FF00C301"
                       Grid.Column="4" />
            <Rectangle Fill="#FF00AB08"
                       Grid.Column="5" />
        </Grid>

        <!--#region Overview -->
        <ItemsControl ItemsSource="{Binding Groups}"
                      d:ItemsSource="{d:SampleData ItemCount=6}"
                      VerticalAlignment="Top" 
                      HorizontalAlignment="Center">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Vertical"
                                Margin="15, 10">
                        <TextBlock Text="{Binding GroupNumber}"
                                   d:Text="1"
                                   FontSize="40"
                                   Foreground="White"
                                   TextAlignment="Center" />
                        <TextBlock Text="{Binding Points}"
                                   FontSize="50"
                                   Foreground="White"
                                   TextAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
        <!--#endregion-->

        <Button x:Name="BtnRetry"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Content="Opnieuw"
                Foreground="White"
                Margin="5"
                Visibility="{Binding CanStart, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <TextBlock x:Name="TxtPoints"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Grid.Row="0"
                   Grid.RowSpan="2"
                   Text="{Binding AmountOfPoints}"
                   d:Text="420"
                   Margin="0,-20,0,0"
                   FontSize="200"
                   Foreground="White" />
        <TextBlock x:Name="TxtPressBtn"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Grid.Row="1"
                   Text="Druk op de knop"
                   TextWrapping="Wrap"
                   FontSize="100"
                   Foreground="White"
                   Visibility="Collapsed" />

        <!-- ROW 2 -->
        <StackPanel Grid.Row="2"
                    Orientation="Vertical"
                    Margin="0,50,0,0">
            <TextBlock x:Name="TxtName"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Grid.Row="2"
                       d:Text="Naam"
                       Text="{Binding Name}"
                       TextWrapping="Wrap"
                       FontSize="100"
                       Foreground="White"
                       Margin="0,0,0,0" />
            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="TxtGroupTxt"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Grid.Row="2"
                           Text="Groepje:"
                           TextWrapping="Wrap"
                           FontSize="70"
                           Foreground="White"
                           Margin="0,0,10,0" />
                <TextBlock x:Name="TxtGroup"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Grid.Row="2"
                           d:Text="1"
                           Text="{Binding GroupNumber}"
                           TextWrapping="Wrap"
                           FontSize="80"
                           Foreground="White"
                           Margin="0,0,0,0" />
            </StackPanel>
        </StackPanel>




        <Button x:Name="BtnStart"
                Content="Klik hier om te starten"
                Command="{Binding StartCommand}"
                Visibility="{Binding CanStart, Converter={StaticResource BoolToVisibilityConverter}}"
                Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Foreground="White"
                Style="{StaticResource MaterialDesignOutlinedButton}"
                FontSize="22"
                Height="50" />
    </Grid>
</UserControl>
