<UserControl x:Class="WelpenScoreboard.WpfUI.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WelpenScoreboard.WpfUI.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center">
            <materialDesign:Card x:Name="PointsCard" BorderThickness="1"
                                 BorderBrush="Black"
                                 HorizontalAlignment="Center"
                                 Margin="10">
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPointsHeader"
                               Text="Punten"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="5" />
                    <ItemsControl ItemsSource="{Binding Groups}"
                                  d:ItemsSource="{d:SampleData ItemCount=6}"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical"
                                            Margin="10, 10">
                                    <TextBlock TextAlignment="Center"
                                               TextDecorations="Underline">
                                        <Run Text="Groep" />
                                        <Run Text="{Binding GroupNumber}"
                                             d:Text="1" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Points}"
                                               TextAlignment="Center"
                                               ToolTip="Huidig aantal punten van het groepje"
                                               Opacity="0.7" />
                                    <TextBox Text="{Binding NewPoints}"
                                             TextAlignment="Center"
                                             materialDesign:HintAssist.Hint="Nieuw"
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </materialDesign:Card>
            <materialDesign:Card BorderThickness="1"
                                 BorderBrush="Black"
                                 HorizontalAlignment="Center"
                                 Margin="10"
                                 Width="{Binding ActualWidth, ElementName=PointsCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--#region Row 0 -->
                    <TextBlock x:Name="TxtDateHeader"
                               Text="Datum"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="5"
                               Grid.Row="0" />
                    <!--#endregion-->

                    <!--#region Row 1 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Grid.Row="1">
                        <TextBlock x:Name="TxtStartDate"
                                   Text="Start van zomerkamp: "
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="13,5"
                                   Opacity="0.8" />
                        <DatePicker x:Name="DatePickerStartDate"
                                    Margin="5"
                                    FontSize="18"
                                    SelectedDate="{Binding StartSummerCampDate}" />
                    </StackPanel>
                    <!--#endregion-->

                    <!--#region Row 2 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Grid.Row="2">
                        <TextBlock x:Name="TxtCurrentDate"
                                   Text="Huidige datum: "
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="5"
                                   Opacity="0.8" />
                        <DatePicker x:Name="DatePickerCurrentDate"
                                    SelectedDate="{Binding CurrentDate}"
                                    Margin="5"
                                    FontSize="18" />
                    </StackPanel>
                    <!--#endregion-->
                </Grid>
            </materialDesign:Card >

            <materialDesign:Card BorderThickness="1"
                                 BorderBrush="Black"
                                 HorizontalAlignment="Center"
                                 Margin="10"
                                 Width="{Binding ActualWidth, ElementName=PointsCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TxtResetHeader"
                               Text="Begin opnieuw"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="5"
                               HorizontalAlignment="Left"
                               Grid.Row="0" />

                    <Button x:Name="BtnResetGroupStart"
                            Content="Reset start groep naar 1"
                            MinWidth="200"
                            MinHeight="30"
                            FontSize="18"
                            Margin="20,5"
                            Grid.Row="1" />
                </Grid>
            </materialDesign:Card>
        </StackPanel>
    </Grid>
</UserControl>
